prefix :       <http://example.org/>
prefix xsd:    <http://www.w3.org/2001/XMLSchema#>
prefix schema: <http://schema.org/>

:Book {
 :name          xsd:string         ;
 :numberOfPages xsd:integer  ?     ;
 :author        @:Person     +     ;
 :publisher     IRI          ?     ;
 :maintainer    @:Person     {1,3} ;
 :related       @:Book       *
}
:Person {}
:Organization {}
