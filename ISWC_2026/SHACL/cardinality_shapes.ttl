prefix :       <http://example.org/> 
prefix sh:     <http://www.w3.org/ns/shacl#> 
prefix xsd:    <http://www.w3.org/2001/XMLSchema#>
prefix schema: <http://schema.org/>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>

:User a sh:NodeShape ;
   sh:property [
    sh:path     schema:follows ; 
    sh:minCount 2 ;
    sh:maxCount 3 ;
  ] .
