prefix :       <http://example.org/> 
prefix sh:     <http://www.w3.org/ns/shacl#> 
prefix xsd:    <http://www.w3.org/2001/XMLSchema#>
prefix schema: <http://schema.org/>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix foaf: <http://xmlns.com/foaf/0.1/>

:UserShape a sh:NodeShape ;
 sh:targetClass :User ;
 sh:sparql [ a sh:SPARQLConstraint ;
  sh:message "Vaue of schema:name = \"{$name}\" must be equal to \"{$givenName} {$familyName}\"";
  sh:prefixes [ sh:declare [
    sh:prefix "schema" ; 
    sh:namespace "http://schema.org/"^^xsd:anyURI ;
   ]] ;
 sh:select
  """SELECT $this ?name $givenName $familyName
     WHERE {
      $this schema:name ?name .
      $this schema:givenName ?givenName .
      $this schema:familyName ?familyName .
      FILTER (!isLiteral(?value) || 
              !isLiteral(?givenName) || !isLiteral(?familyName) ||
              concat(str(?givenName), ' ', str(?familyName))!=?name )
     }""" ;
] .
