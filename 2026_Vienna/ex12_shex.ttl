@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sx: <http://www.w3.org/ns/shex#> .
@prefix : <http://example.org/> .

[ a sx:Schema ;
	sx:shapes ( :Person ) ] .

:Person a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
 	sx:expression [ 
		a sx:EachOf ;
		sx:expressions (
			[ a sx:TripleConstraint ;
			  sx:valueExpr [
				a sx:NodeConstraint ;
		    	sx:datatype xsd:string 
			  ] ;
	          sx:predicate :name 
			]
			[ a sx:TripleConstraint ;
			  sx:valueExpr :Person ;
			  sx:predicate :knows ;
		      sx:max -1 ;
		      sx:min 0
			]
		) 
	] 
  ] .
